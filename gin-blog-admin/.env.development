# Loaded in development mode
# Public base path for assets, must start and end with '/'
VITE_PUBLIC_PATH = '/'

# Server URL (used to load images for local file uploads)
VITE_SERVER_URL = 'http://localhost:8765' # Static assets are served by the backend service

# Base API
VITE_BASE_API = '/api'

# Whether to generate routes from backend
VITE_BACK_ROUTER = true

# Require captcha on login; include TCaptcha.js in index.html if true
VITE_USE_CAPTCHA = false
