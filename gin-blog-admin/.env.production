# Loaded in production mode
# Public path for static assets; must start and end with /
VITE_PUBLIC_PATH = '/admin/'

# Server URL (used to load images for local file uploads)
VITE_SERVER_URL = 'http://localhost' # Static resources are mounted by the backend service

# Base API: if using a proxy, set the proxy API path; otherwise use the full URL. See setting/proxy-config.js
VITE_BASE_API = '/api'

# Whether routes are generated by the backend
VITE_BACK_ROUTER = true

# Whether captcha is required on login; TCaptcha.js must be included in index.html
VITE_USE_CAPTCHA = false

# 是否使用 mock 数据: true 时不请求后端, 由 src/mock 提供假数据
VITE_USE_MOCK = false
