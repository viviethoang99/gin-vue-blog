server {
    listen 80;
    # Domain bound to certificate
    server_name ${SERVER_NAME};
    # Force HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    # Default SSL port 443
    listen 443 ssl;
    # Domain for the certificate
    server_name ${SERVER_NAME};
    # Certificate file path (relative or absolute)
    ssl_certificate /etc/nginx/crt/server.crt;
    # Private key file path (relative or absolute)
    ssl_certificate_key /etc/nginx/crt/server.key;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE; 
    ssl_prefer_server_ciphers on;

    root /usr/share/nginx/html;

    ######### Reverse Proxy start ########
    location /api {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT};
        # Forward real client IP
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $remote_addr;

        client_max_body_size 40M;
    }
    # Gin serves uploads, Nginx proxies to Gin (needed for local file upload)
    location /public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    location /admin/public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    ######### Reverse Proxy end ########

    ######### Static Assets start ########
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /admin {
        try_files $uri $uri/ /admin/index.html;
    }
    location ~ .*\.(js|json|css)$ {
        gzip on;
        gzip_static on; 
        gzip_min_length 1k;
        gzip_http_version 1.1;
        gzip_comp_level 9;
        gzip_types text/css application/javascript application/json;
        root /usr/share/nginx/html;
    }
    ######### Static Assets end ########
}