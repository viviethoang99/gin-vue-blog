# Public base path for assets, must start and end with '/'
VITE_PUBLIC_PATH = '/'

# Base API: use proxy path when proxy is set; otherwise use full URL
VITE_API = '/api'

# Backend URL
VITE_BACKEND_URL = 'http://localhost:8765'

# Require captcha on login
VITE_USE_CAPTCHA = false

# 是否使用 mock 数据: true 时不请求后端, 由 src/mock 提供假数据
VITE_USE_MOCK = true
