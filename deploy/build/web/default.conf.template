server {
    listen 80;
    server_name ${SERVER_NAME};
    root /usr/share/nginx/html;

    ######### Reverse Proxy start ########
    location /api {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT};
        # Forward real client IP
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $remote_addr;

        # 后端限制单个上传文件 10MB, 这里留一点 multipart 的余量,
        # 超出的请求在 Nginx 就挡掉, 不用把整个 body 转给后端
        client_max_body_size 12M;
    }
    # Gin serves uploads, Nginx proxies to Gin (needed for local file upload)
    location /public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    location /admin/public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    ######### Reverse Proxy end ########

    ######### Static Assets start ########
    location = /admin {
        return 301 /admin/;
    }
    location ^~ /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    ######### Static Assets end ########
}
