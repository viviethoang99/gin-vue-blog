# https://docs.docker.com/compose/environment-variables/
# .env in the same directory as docker-compose.yml will be loaded

WEB_BUILD_CONTEXT=../..

# Data storage directory (defaults to ./gvb under start)
DATA_DIRECTORY=./gvb

# Redis
REDIS_PORT=63799
REDIS_PASSWORD=66554321

# MySQL
MYSQL_PORT=33066
MYSQL_ROOT_PASSWORD=12345566

# Backend service
SERVER_PORT = 8765 # Service port

# Frontend service
# To enable HTTPS, add valid server.crt and server.key to start/
USE_HTTPS=false
SERVER_NAME=localhost # Domain or localhost

# Docker Network: leave as-is unless conflicts occur
SUBNET=172.12.0.0/24
REDIS_HOST=172.12.0.2
MYSQL_HOST=172.12.0.3
BACKEND_HOST=172.12.0.4
FRONTEND_HOST=172.12.0.6